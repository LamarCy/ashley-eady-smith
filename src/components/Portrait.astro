---
// Ashley's portrait. Drop a photo at src/assets/portrait.jpg and it is used
// everywhere; until then a 4:5 Naples Yellow placeholder holds the space.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { class?: string; eager?: boolean; sizes?: string }
const { class: cls = '', eager = false, sizes = '(min-width: 860px) 40vw, 100vw' } = Astro.props;
const found = import.meta.glob<{ default: ImageMetadata }>('../assets/portrait.{jpg,jpeg,png,webp}', { eager: true });
const portrait = Object.values(found)[0]?.default;
---
{portrait ? (
  <Image
    src={portrait}
    alt="Ashley Eady Smith"
    class:list={['portrait', cls]}
    widths={[480, 800, 1200, 1600]}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    format="webp"
  />
) : (
  <div class:list={['portrait', 'placeholder', cls]} role="img" aria-label="Portrait of Ashley (placeholder)">Portrait of Ashley</div>
)}

<style is:global>
  .portrait { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
</style>
